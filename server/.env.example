DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>?schema=public

PORT=5000
HOST=127.0.0.1

# Authentication
# Session duration in hours (default: 8, max: 720)
SESSION_DURATION_HOURS=8
# Cookie name for the session token
SESSION_COOKIE_NAME=sid
# Trusted frontend origin for credentialed CORS — required for cookie-based auth
# Never use a wildcard with credentials=true
# Example: FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

NODE_ENV=development
