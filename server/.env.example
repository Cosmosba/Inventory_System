DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>?schema=public

PORT=5000
HOST=127.0.0.1

# Authentication
# Session duration in hours (default: 8, max: 720)
SESSION_DURATION_HOURS=8
# Cookie name for the session token
SESSION_COOKIE_NAME=sid

# Trusted frontend origin for credentialed CORS and CSRF protection.
# Must be the exact URL of the frontend — no trailing slash, no wildcard.
# REQUIRED in production: the server will refuse to start without it.
# Optional in development (CSRF checks are skipped when unset).
# Example (development): FRONTEND_ORIGIN=http://localhost:5173
# Example (production):  FRONTEND_ORIGIN=https://app.example.com
FRONTEND_ORIGIN=http://localhost:5173

NODE_ENV=development
