{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["node", "express", "cookie-parser", "cors"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "generated"]
}
